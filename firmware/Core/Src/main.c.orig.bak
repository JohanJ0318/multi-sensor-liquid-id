// TEMP BEGIN
static inline void DS18B20_LineLow(void)
{
    HAL_GPIO_WritePin(TEMP_GPIO_Port, TEMP_Pin, GPIO_PIN_RESET);
}

static inline void DS18B20_LineRelease(void)
{
    HAL_GPIO_WritePin(TEMP_GPIO_Port, TEMP_Pin, GPIO_PIN_SET);
}

static inline uint8_t DS18B20_LineRead(void)
{
    return HAL_GPIO_ReadPin(TEMP_GPIO_Port, TEMP_Pin) == GPIO_PIN_SET;
}

static void delay_us(uint32_t us)
{
    uint32_t start = __HAL_TIM_GET_COUNTER(&htim2);
    uint32_t required_ticks = us * TIM2_TICKS_PER_US;

    while ((__HAL_TIM_GET_COUNTER(&htim2) - start) < required_ticks)
    {
    }
}

static uint8_t DS18B20_Start(void)
{
    uint8_t response;

    DS18B20_LineRelease();
    delay_us(10);

    if (!DS18B20_LineRead())
    {
        return 0U;
    }

    __disable_irq();

    DS18B20_LineLow();
    delay_us(500);

    DS18B20_LineRelease();
    delay_us(70);

    response = DS18B20_LineRead() ? 0U : 1U;

    __enable_irq();

    delay_us(410);

    return response;
}

void DS18B20_WriteBit(uint8_t bit)
{
    __disable_irq();

    DS18B20_LineLow();

    if (bit)
    {
        delay_us(6);
        DS18B20_LineRelease();
        delay_us(64);
    }
    else
    {
        delay_us(60);
        DS18B20_LineRelease();
        delay_us(10);
    }

    __enable_irq();
}

static uint8_t DS18B20_ReadBit(void)
{
    uint8_t bit;

    __disable_irq();

    DS18B20_LineLow();
    delay_us(3);

    DS18B20_LineRelease();
    delay_us(12);

    bit = DS18B20_LineRead();

    delay_us(50);

    __enable_irq();

    return bit;
}

void DS18B20_WriteByte(uint8_t data)
{
    for (uint8_t i = 0; i < 8; i++)
    {
        DS18B20_WriteBit(data & 0x01U);
        data >>= 1;
    }
}

uint8_t DS18B20_ReadByte(void)
{
    uint8_t value = 0;

    for (uint8_t i = 0; i < 8; i++)
    {
        if (DS18B20_ReadBit())
        {
            value |= (1U << i);
        }
    }

    return value;
}

static float DS18B20_ReadTemp(void)
{
    uint8_t scratchpad[9];
    int16_t raw_temperature;

    ds18b20_present = DS18B20_Start();

    if (!ds18b20_present)
    {
        return -1000.0f;
    }

    DS18B20_WriteByte(0xCC);  // Skip ROM
    DS18B20_WriteByte(0x44);  // Start conversion

    HAL_Delay(750);

    ds18b20_present = DS18B20_Start();

    if (!ds18b20_present)
    {
        return -1000.0f;
    }

    DS18B20_WriteByte(0xCC);  // Skip ROM
    DS18B20_WriteByte(0xBE);  // Read scratchpad

    for (uint8_t i = 0; i < 9; i++)
    {
        scratchpad[i] = DS18B20_ReadByte();
    }

    if ((scratchpad[0] == 0x00U && scratchpad[1] == 0x00U) ||
        (scratchpad[0] == 0xFFU && scratchpad[1] == 0xFFU))
    {
        return -1000.0f;
    }

    raw_temperature =
        (int16_t)(((uint16_t)scratchpad[1] << 8) | scratchpad[0]);

    return (float)raw_temperature / 16.0f;
}
// TEMP END

// LOAD BEGIN
static uint16_t ADC_ReadSingle(ADC_HandleTypeDef *hadc)
{
    uint16_t value = 0;

    if (HAL_ADC_Start(hadc) != HAL_OK)
    {
        return 0;
    }

    if (HAL_ADC_PollForConversion(hadc, 10U) == HAL_OK)
    {
        value = (uint16_t)HAL_ADC_GetValue(hadc);
    }

    HAL_ADC_Stop(hadc);

    return value;
}

static uint16_t LoadCell_ReadFiltered(uint16_t sample_count)
{
    if (sample_count < 3U)
    {
        return 0U;
    }

    uint32_t sum = 0;
    uint16_t minimum = 4095U;
    uint16_t maximum = 0U;

    for (uint16_t i = 0; i < sample_count; i++)
    {
        uint16_t sample = ADC_ReadSingle(&hadc2);

        sum += sample;

        if (sample < minimum)
        {
            minimum = sample;
        }

        if (sample > maximum)
        {
            maximum = sample;
        }
    }

    sum -= minimum;
    sum -= maximum;

    return (uint16_t)(sum / (sample_count - 2U));
}

static float LoadCell_GetWeight(uint16_t sample_count)
{
    load_adc_raw = LoadCell_ReadFiltered(sample_count);

    if (load_counts_per_gram == 0.0f)
    {
        return 0.0f;
    }

    return ((float)load_adc_raw - load_zero_adc) /
           load_counts_per_gram;
}

static float LoadCell_FilterWeight(float new_weight)
{
    float difference;
    float alpha;

    if (!weight_filter_initialized)
    {
        filtered_weight_g = new_weight;
        weight_filter_initialized = 1U;
        return filtered_weight_g;
    }

    difference = fabsf(new_weight - filtered_weight_g);

    if (difference > 10.0f)
    {
        alpha = 0.85f;   // Rapid response to a new load
    }
    else if (difference > 3.0f)
    {
        alpha = 0.50f;   // Moderate correction
    }
    else
    {
        alpha = 0.15f;   // Smooth the stable reading
    }

    filtered_weight_g =
        alpha * new_weight +
        (1.0f - alpha) * filtered_weight_g;

    return filtered_weight_g;
}

static float LoadCell_ApplyDeadband(float new_weight)
{
    static float displayed_weight = 0.0f;

    if (fabsf(new_weight - displayed_weight) >= 1.0f)
    {
        displayed_weight = new_weight;
    }

    return displayed_weight;
}

static float LoadCell_MedianFilter(float new_weight)
{
    float sorted[WEIGHT_MEDIAN_WINDOW];
    uint8_t count;

    /* Add the newest result to the circular history buffer. */
    weight_history[weight_history_index] = new_weight;

    weight_history_index++;

    if (weight_history_index >= WEIGHT_MEDIAN_WINDOW)
    {
        weight_history_index = 0U;
    }

    if (weight_history_count < WEIGHT_MEDIAN_WINDOW)
    {
        weight_history_count++;
    }

    count = weight_history_count;

    /* Copy the valid history values into a temporary array. */
    for (uint8_t i = 0U; i < count; i++)
    {
        sorted[i] = weight_history[i];
    }

    /* Insertion sort. This is efficient enough for five values. */
    for (uint8_t i = 1U; i < count; i++)
    {
        float value = sorted[i];
        int8_t j = (int8_t)i - 1;

        while ((j >= 0) && (sorted[j] > value))
        {
            sorted[j + 1] = sorted[j];
            j--;
        }

        sorted[j + 1] = value;
    }

    /* Return the middle value for an odd number of readings. */
    if ((count & 1U) != 0U)
    {
        return sorted[count / 2U];
    }

    /* Average the two middle values while the buffer is filling. */
    return (sorted[(count / 2U) - 1U] +
            sorted[count / 2U]) / 2.0f;
}
// LOAD END

static float MedianFloat(float values[], uint16_t count)
{
    if ((values == NULL) || (count == 0U))
    {
        return 0.0f;
    }

    /*
     * Insertion sort is appropriate for this small array.
     * The original array is intentionally sorted in place.
     */
    for (uint16_t i = 1U; i < count; i++)
    {
        float current = values[i];
        int32_t j = (int32_t)i - 1;

        while ((j >= 0) && (values[j] > current))
        {
            values[j + 1] = values[j];
            j--;
        }

        values[j + 1] = current;
    }

    if ((count & 1U) != 0U)
    {
        return values[count / 2U];
    }

    return (values[(count / 2U) - 1U] +
            values[count / 2U]) / 2.0f;
}

static uint16_t MedianUint16(uint16_t values[], uint16_t count)
{
    if ((values == NULL) || (count == 0U))
    {
        return 0U;
    }

    for (uint16_t i = 1U; i < count; i++)
    {
        uint16_t current = values[i];
        int32_t j = (int32_t)i - 1;

        while ((j >= 0) && (values[j] > current))
        {
            values[j + 1] = values[j];
            j--;
        }

        values[j + 1] = current;
    }

    if ((count & 1U) != 0U)
    {
        return values[count / 2U];
    }

    return (uint16_t)(
        ((uint32_t)values[(count / 2U) - 1U] +
         (uint32_t)values[count / 2U]) / 2U);
}

// CONDUCTIVITY BEGIN
static uint16_t Conductivity_Read(uint16_t sample_count)
{
    uint32_t sum = 0U;
    uint16_t minimum = 4095U;
    uint16_t maximum = 0U;

    if (sample_count < 3U)
    {
        return 0U;
    }

    /*
     * Force the divider node to a known discharged state
     * before beginning each measurement.
     */
    HAL_GPIO_WritePin(COND_IN_GPIO_Port,
                      COND_IN_Pin,
                      GPIO_PIN_RESET);

    HAL_Delay(10);

    /*
     * Apply excitation and allow the divider and ADC node
     * to settle completely.
     */
    HAL_GPIO_WritePin(COND_IN_GPIO_Port,
                      COND_IN_Pin,
                      GPIO_PIN_SET);

    HAL_Delay(10);

    /* Discard initial ADC conversions. */
    (void)ADC_ReadSingle(&hadc1);
    (void)ADC_ReadSingle(&hadc1);
    (void)ADC_ReadSingle(&hadc1);

    for (uint16_t i = 0U; i < sample_count; i++)
    {
        uint16_t sample = ADC_ReadSingle(&hadc1);

        sum += sample;

        if (sample < minimum)
        {
            minimum = sample;
        }

        if (sample > maximum)
        {
            maximum = sample;
        }
    }

    HAL_GPIO_WritePin(COND_IN_GPIO_Port,
                      COND_IN_Pin,
                      GPIO_PIN_RESET);

    sum -= minimum;
    sum -= maximum;

    return (uint16_t)(sum / (sample_count - 2U));
}
// CONDUCTIVITY END

static void Measurement_RunFiveSeconds(MeasurementFrame *frame)
{
    float weight_samples[FINAL_WEIGHT_SAMPLES];
    uint16_t conductivity_samples[FINAL_COND_SAMPLES];

    uint16_t weight_count = 0U;
    uint16_t conductivity_count = 0U;

    float temperature_sum = 0.0f;
    uint8_t temperature_count = 0U;

    uint32_t measurement_start_ms;
    uint32_t next_status_update_ms;
    uint8_t processing_step = 0U;

    if (frame == NULL)
    {
        return;
    }

    memset(frame, 0, sizeof(*frame));

    measurement_start_ms = HAL_GetTick();

    /* Show the first processing frame immediately. */
    OLED_Command(0xAF);
    OLED_ShowProcessing(processing_step);
    HAL_Delay(150U);

    processing_step = 1U;

    /* Turn the OLED off before measuring. */
    OLED_Command(0xAE);
    HAL_Delay(50U);

    /*
     * Collect temperature readings.
     * The OLED stays off during each actual sensor transaction.
     */
    for (uint8_t i = 0U; i < FINAL_TEMP_SAMPLES; i++)
    {
        float temperature = DS18B20_ReadTemp();

        if (ds18b20_present &&
            (temperature >= TEMP_MIN_VALID_C) &&
            (temperature <= TEMP_MAX_VALID_C))
        {
            temperature_sum += temperature;
            temperature_count++;
        }

        /* Briefly display the next animation frame. */
        OLED_Command(0xAF);
        OLED_ShowProcessing(processing_step);
        HAL_Delay(100U);

        processing_step++;

        if (processing_step >= 4U)
        {
            processing_step = 0U;
        }

        OLED_Command(0xAE);
        HAL_Delay(50U);
    }

    /*
     * Schedule the next animation update relative to the current
     * time. This prevents rapid catch-up blinking after the
     * blocking temperature measurements.
     */
    next_status_update_ms = HAL_GetTick() + 1000U;

    /*
     * Use the remaining measurement period for repeated mass and
     * conductivity readings.
     */
    while (((HAL_GetTick() - measurement_start_ms) <
            ANALOG_ACQUISITION_END_MS) &&
           (weight_count < FINAL_WEIGHT_SAMPLES) &&
           (conductivity_count < FINAL_COND_SAMPLES))
    {
        uint32_t now_ms = HAL_GetTick();

        /*
         * Show no more than one animation frame per second.
         * The signed comparison remains safe across tick rollover.
         */
        if ((int32_t)(now_ms - next_status_update_ms) >= 0)
        {
            OLED_Command(0xAF);
            OLED_ShowProcessing(processing_step);
            HAL_Delay(100U);

            processing_step++;

            if (processing_step >= 4U)
            {
                processing_step = 0U;
            }

            OLED_Command(0xAE);

            /* Let OLED-related noise settle before ADC sampling. */
            HAL_Delay(50U);

            next_status_update_ms = HAL_GetTick() + 1000U;
        }

        weight_samples[weight_count] =
            LoadCell_GetWeight(32U);

        weight_count++;

        conductivity_samples[conductivity_count] =
            Conductivity_Read(64U);

        conductivity_count++;
    }

    /* Calculate the final median mass. */
    if (weight_count > 0U)
    {
        frame->weight_g =
            MedianFloat(weight_samples, weight_count);

        frame->load_adc = load_adc_raw;

        frame->load_valid =
            (frame->load_adc > LOAD_ADC_MIN_VALID) &&
            (frame->load_adc < LOAD_ADC_MAX_VALID);
    }
    else
    {
        frame->weight_g = 0.0f;
        frame->load_adc = 0U;
        frame->load_valid = 0U;
    }

    /* Calculate the final median conductivity reading. */
    if (conductivity_count > 0U)
    {
        frame->conductivity_adc =
            MedianUint16(conductivity_samples,
                         conductivity_count);

        frame->conductivity_voltage =
            ((float)frame->conductivity_adc * 3.3f) /
            4095.0f;

        frame->conductivity_valid =
            (frame->conductivity_adc > COND_ADC_MIN_VALID) &&
            (frame->conductivity_adc < COND_ADC_MAX_VALID);
    }
    else
    {
        frame->conductivity_adc = 0U;
        frame->conductivity_voltage = 0.0f;
        frame->conductivity_valid = 0U;
    }

    /* Calculate the average valid temperature. */
    if (temperature_count > 0U)
    {
        frame->temperature_c =
            temperature_sum / (float)temperature_count;

        frame->temperature_valid = 1U;
    }
    else
    {
        frame->temperature_c = -1000.0f;
        frame->temperature_valid = 0U;
    }

    /* Keep the OLED off until the five-second period finishes. */
    OLED_Command(0xAE);

    while ((HAL_GetTick() - measurement_start_ms) <
           MEASUREMENT_TOTAL_MS)
    {
        HAL_Delay(1U);
    }
}

static void Measurement_DisplayFinal(const MeasurementFrame *frame)
{
    char buffer[160];

    if (frame == NULL)
    {
        return;
    }

    measured_weight_g = frame->weight_g;
    measured_temp_c = frame->temperature_c;
    cond_adc_raw = frame->conductivity_adc;

    /* Turn the OLED on only after all analog sampling is complete. */
    OLED_Command(0xAF);

    OLED_ShowMeasurements(frame->conductivity_adc,
                          frame->weight_g,
                          frame->temperature_c);

    snprintf(buffer,
             sizeof(buffer),
             "FINAL | COND:%u | WEIGHT:%.1f G | TEMP:%.2f C | VALID:%u\r\n",
             frame->conductivity_adc,
             frame->weight_g,
             frame->temperature_c,
             Measurement_IsValid(frame));

    BT_SendString(buffer);
}

static void Measurement_Acquire(MeasurementFrame *frame)
{
    if (frame == NULL)
    {
        return;
    }

    /* Conductivity */
    frame->conductivity_adc = Conductivity_Read(16U);

    frame->conductivity_voltage =
        ((float)frame->conductivity_adc * 3.3f) / 4095.0f;

    frame->conductivity_valid =
        (frame->conductivity_adc > COND_ADC_MIN_VALID) &&
        (frame->conductivity_adc < COND_ADC_MAX_VALID);

    /* Load cell */
    frame->weight_g =
        LoadCell_FilterWeight(
            LoadCell_GetWeight(16U));

    frame->load_adc = load_adc_raw;

    frame->load_valid =
        (frame->load_adc > LOAD_ADC_MIN_VALID) &&
        (frame->load_adc < LOAD_ADC_MAX_VALID);

    /* Temperature */
    frame->temperature_c = DS18B20_ReadTemp();

    frame->temperature_valid =
        ds18b20_present &&
        (frame->temperature_c >= TEMP_MIN_VALID_C) &&
        (frame->temperature_c <= TEMP_MAX_VALID_C);
}

static uint8_t Measurement_IsValid(const MeasurementFrame *frame)
{
    if (frame == NULL)
    {
        return 0U;
    }

    return frame->conductivity_valid &&
           frame->load_valid &&
           frame->temperature_valid;
}

static void Measurement_Send(const MeasurementFrame *frame)
{
    char buffer[160];

    if (frame == NULL)
    {
        return;
    }

    snprintf(buffer,
             sizeof(buffer),
             "COND:%u,%.3fV | LOAD:%u,%.1fg | TEMP:%.2fC | VALID:%u\r\n",
             frame->conductivity_adc,
             frame->conductivity_voltage,
             frame->load_adc,
             frame->weight_g,
             frame->temperature_c,
             Measurement_IsValid(frame));

    BT_SendString(buffer);
}
/* USER CODE END 0 */

