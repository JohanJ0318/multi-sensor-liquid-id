// BLE BEGIN
void RN4871_Reset(void)
{
    // Most reset pins are active-low.
    HAL_GPIO_WritePin(RN4871_RESET_PORT, RN4871_RESET_PIN, GPIO_PIN_RESET);
    HAL_Delay(20);
    HAL_GPIO_WritePin(RN4871_RESET_PORT, RN4871_RESET_PIN, GPIO_PIN_SET);
    HAL_Delay(500);
}

void BT_SendString(const char *str)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), HAL_MAX_DELAY);
}
// BLE END

// OLED BEGIN
void OLED_Select(void)
{
    HAL_GPIO_WritePin(OLED_CS_PORT, OLED_CS_PIN, GPIO_PIN_RESET);
}

void OLED_Unselect(void)
{
    HAL_GPIO_WritePin(OLED_CS_PORT, OLED_CS_PIN, GPIO_PIN_SET);
}

void OLED_Command(uint8_t cmd)
{
    HAL_GPIO_WritePin(OLED_DC_PORT, OLED_DC_PIN, GPIO_PIN_RESET);
    OLED_Select();
    HAL_SPI_Transmit(&hspi1, &cmd, 1, HAL_MAX_DELAY);
    OLED_Unselect();
}

void OLED_Data(uint8_t data)
{
    HAL_GPIO_WritePin(OLED_DC_PORT, OLED_DC_PIN, GPIO_PIN_SET);
    OLED_Select();
    HAL_SPI_Transmit(&hspi1, &data, 1, HAL_MAX_DELAY);
    OLED_Unselect();
}

static void OLED_SetCursor(uint8_t page, uint8_t column)
{
    /*
     * SH1106 has a two-column display RAM offset.
     */
    uint8_t adjusted_column = column + 2U;

    OLED_Command((uint8_t)(0xB0U + page));
    OLED_Command((uint8_t)(adjusted_column & 0x0FU));
    OLED_Command((uint8_t)(0x10U |
                           ((adjusted_column >> 4U) & 0x0FU)));
}

static void OLED_WriteChar(char character)
{
    const uint8_t *glyph = OLED_GetGlyph(character);
    uint8_t data[6];

    for (uint8_t i = 0U; i < 5U; i++)
    {
        data[i] = glyph[i];
    }

    data[5] = 0x00;

    HAL_GPIO_WritePin(OLED_DC_PORT, OLED_DC_PIN, GPIO_PIN_SET);

    OLED_Select();
    HAL_SPI_Transmit(&hspi1, data, sizeof(data), 10U);
    OLED_Unselect();
}

static void OLED_WriteLine(uint8_t page, const char *text)
{
    OLED_SetCursor(page, 0U);

    for (uint8_t position = 0U; position < 21U; position++)
    {
        if ((text != NULL) && (*text != '\0'))
        {
            OLED_WriteChar(*text);
            text++;
        }
        else
        {
            OLED_WriteChar(' ');
        }
    }
}

static void OLED_ShowMeasurements(uint16_t conductivity,
                                  float weight_g,
                                  float temperature_c)
{
    char line[22];

    snprintf(line,
             sizeof(line),
             "COND: %u",
             conductivity);

    OLED_WriteLine(0U, line);

    snprintf(line,
             sizeof(line),
             "WEIGHT: %.1f G",
             weight_g);

    OLED_WriteLine(2U, line);

    if (ds18b20_present && temperature_c > -100.0f)
    {
        snprintf(line,
                 sizeof(line),
                 "TEMP: %.2f C",
                 temperature_c);
    }
    else
    {
        snprintf(line,
                 sizeof(line),
                 "TEMP: ERROR");
    }

    OLED_WriteLine(4U, line);
}

static void OLED_ShowProcessing(uint8_t dots)
{
    char line[22];

    strcpy(line, "MEASURING");

    for (uint8_t i = 0; i < dots; i++)
    {
        strcat(line, ".");
    }

    OLED_Clear();
    OLED_WriteLine(2, line);
}

void OLED_Reset(void)
{
    HAL_GPIO_WritePin(OLED_RES_PORT, OLED_RES_PIN, GPIO_PIN_RESET);
    HAL_Delay(20);
    HAL_GPIO_WritePin(OLED_RES_PORT, OLED_RES_PIN, GPIO_PIN_SET);
    HAL_Delay(20);
}

void OLED_Init(void)
{
    OLED_Reset();

    OLED_Command(0xAE); // Display OFF
    OLED_Command(0xD5); // Set display clock
    OLED_Command(0x80);
    OLED_Command(0xA8); // Multiplex ratio
    OLED_Command(0x3F);
    OLED_Command(0xD3); // Display offset
    OLED_Command(0x00);
    OLED_Command(0x40); // Start line
    OLED_Command(0xAD); // DC-DC control for SH1106
    OLED_Command(0x8B);
    OLED_Command(0xA1); // Segment remap
    OLED_Command(0xC8); // COM scan direction
    OLED_Command(0xDA); // COM pins
    OLED_Command(0x12);
    OLED_Command(0x81); // Contrast
    OLED_Command(0x30);
    OLED_Command(0xD9); // Pre-charge
    OLED_Command(0x1F);
    OLED_Command(0xDB); // VCOM detect
    OLED_Command(0x40);
    OLED_Command(0xA4); // Resume RAM content
    OLED_Command(0xA6); // Normal display
    OLED_Command(0xAF); // Display ON
}

void OLED_Clear(void)
{
    for (uint8_t page = 0; page < 8; page++)
    {
        OLED_Command(0xB0 + page);
        OLED_Command(0x02); // lower column offset for SH1106
        OLED_Command(0x10); // higher column

        for (uint8_t col = 0; col < 128; col++)
        {
            OLED_Data(0x00);
        }
    }
}

void OLED_Fill(void)
{
    for (uint8_t page = 0; page < 8; page++)
    {
        OLED_Command(0xB0 + page);
        OLED_Command(0x02);
        OLED_Command(0x10);

        for (uint8_t col = 0; col < 128; col++)
        {
            OLED_Data(0xFF);
        }
    }
}

static const uint8_t *OLED_GetGlyph(char character)
{
    switch (character)
    {
        case '0': return FONT_0;
        case '1': return FONT_1;
        case '2': return FONT_2;
        case '3': return FONT_3;
        case '4': return FONT_4;
        case '5': return FONT_5;
        case '6': return FONT_6;
        case '7': return FONT_7;
        case '8': return FONT_8;
        case '9': return FONT_9;

        case 'A': return FONT_A;
        case 'C': return FONT_C;
        case 'D': return FONT_D;
        case 'E': return FONT_E;
        case 'G': return FONT_G;
        case 'H': return FONT_H;
        case 'I': return FONT_I;
        case 'M': return FONT_M;
        case 'N': return FONT_N;
        case 'O': return FONT_O;
        case 'P': return FONT_P;
        case 'R': return FONT_R;
        case 'S': return FONT_S;
        case 'T': return FONT_T;
        case 'U': return FONT_U;
        case 'W': return FONT_W;

        case ':': return FONT_COLON;
        case '.': return FONT_DOT;
        case '-': return FONT_MINUS;
        case ' ':
        default:
            return FONT_SPACE;
    }
}
