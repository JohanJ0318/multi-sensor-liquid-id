<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FAFAFA"
    android:gravity="center_horizontal">

    <!-- Model Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="kNN"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginEnd="8dp" />

        <ToggleButton
            android:id="@+id/toggle_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="NC"
            android:textOff="kNN" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nearest Centroid"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_model_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="k-Nearest Neighbors"
        android:textSize="14sp"
        android:textColor="#9E9E9E"
        android:layout_marginBottom="16dp" />

    <!-- Prediction Result -->
    <TextView
        android:id="@+id/tv_substance_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waiting…"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:gravity="center" />

    <!-- Confidence Gauge -->
    <ProgressBar
        android:id="@+id/progress_confidence"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_confidence_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#00BCD4"
        android:layout_marginTop="8dp" />

    <!-- Status / Error Message -->
    <TextView
        android:id="@+id/tv_status_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Press the start button to begin a measurement"
        android:textSize="14sp"
        android:textColor="#9E9E9E"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="visible" />

    <!-- Feature Values -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:background="@android:color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Feature Values"
            android:textSize="12sp"
            android:textColor="#9E9E9E"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_feature_conductivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conductivity: —"
            android:textSize="16sp"
            android:textColor="#424242"
            android:drawablePadding="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_feature_density"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Density: —"
            android:textSize="16sp"
            android:textColor="#424242"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_feature_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperature: —"
            android:textSize="16sp"
            android:textColor="#424242" />
    </LinearLayout>

</LinearLayout>
