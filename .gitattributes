# ST's HAL/CMSIS is vendor code shipped with STM32CubeIDE. It is committed so
# the project builds out of the box, but it should not count as our source in
# GitHub's language stats, nor clutter diffs and reviews.
firmware/Drivers/** linguist-vendored
firmware/Core/Startup/** linguist-vendored

# Generated by ml/train_model.py -- reviewed as data, not hand-written source.
firmware/Core/Inc/model_params.h linguist-generated

# Keep firmware sources LF and CRLF-stable across Windows/Linux toolchains.
*.c   text eol=lf
*.h   text eol=lf
*.kt  text eol=lf
*.py  text eol=lf
*.csv text eol=lf
